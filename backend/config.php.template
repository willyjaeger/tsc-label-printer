function db_connect() {
    $db = new mysqli(DB_HOST, DB_USER, DB_PASS, DB_NAME);
    if ($db->connect_error) {
        http_response_code(500);
        die(json_encode(['ok' => false, 'error' => 'db_connect_failed']));
    }
    $db->set_charset('utf8mb4');
    return $db;
}
